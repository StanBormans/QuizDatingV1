<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizDating.MVVM.Views.CreateQuiz"
             Title="CreateQuiz">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="10" Spacing="20" x:Name="QuestionsLayout">
                <!-- Page Title -->
                <Label Text="Create Quiz" FontSize="24" HorizontalOptions="Center" />

                <!-- Quiz Name Entry -->
                <Entry x:Name="QuizNameEntry"
                       Placeholder="Enter quiz name here"
                       FontSize="18"
                       Margin="0,10,0,0" />

                <!-- Initial Question Fields -->
                <Entry x:Name="InitialQuestionEntry"
                   Placeholder="Enter your first question title"
                   FontSize="16" />
                <Entry x:Name="InitialDescriptionEntry"
                   Placeholder="Enter your first question description"
                   FontSize="16" />
                <Entry x:Name="InitialOptionAEntry"
                   Placeholder="Enter Option A"
                   FontSize="16" />
                <Picker x:Name="InitialOptionAEffectPicker"
                    Title="Effect of Option A"
                    ItemsSource="{Binding EffectOptions}" />
                <Entry x:Name="InitialOptionBEntry"
                   Placeholder="Enter Option B"
                   FontSize="16" />
                <Picker x:Name="InitialOptionBEffectPicker"
                    Title="Effect of Option B"
                    ItemsSource="{Binding EffectOptions}" />

                <!-- Add Question Button -->
                <Button Text="Add Question"
                        FontSize="16"
                        BackgroundColor="#0ad8c8"
                        TextColor="White"
                        Clicked="OnAddQuestionClicked" />

                <!-- Save Quiz Button -->
                <Button Text="Save Quiz"
                        FontSize="16"
                        BackgroundColor="#0ad8c8"
                        TextColor="White"
                        Margin="0,20,0,0"
                        Clicked="OnSaveQuizClicked" />
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>