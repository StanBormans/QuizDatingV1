<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizDating.MVVM.Views.CreateQuiz"
             Title="CreateQuiz">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="10" Spacing="20" x:Name="QuestionsLayout">
                <Label Text="Create Quiz" FontSize="24" HorizontalOptions="Center" />

                <Entry x:Name="QuizNameEntry"
                       Placeholder="Enter quiz name here"
                       FontSize="18"
                       Margin="0,10,0,0" />

                <Entry x:Name="InitialQuestionEntry"
                       Placeholder="Enter your first question here"
                       FontSize="16" />

                <Button Text="Add Question"
                        FontSize="16"
                        BackgroundColor="#0ad8c8"
                        TextColor="White"
                        Clicked="OnAddQuestionClicked" />

                <Button Text="Save Quiz"
                        FontSize="16"
                        BackgroundColor="#0ad8c8"
                        TextColor="White"
                        Margin="0,20,0,0"
                        Clicked="OnSaveQuizClicked" />
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>