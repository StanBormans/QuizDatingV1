<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizDating.QuizPage"
             Title="QuizPage"
             BackgroundColor="#f883b7"
             Shell.NavBarIsVisible="false">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Grid Grid.Row="0" Padding="10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Text="Back"
                BackgroundColor="#0ad8c8"
                TextColor="White"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                Grid.Column="0"
                Clicked="OnBackClicked" />

            <Label
                Text="Quizzes"
                FontSize="24"
                TextColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Grid.Column="1" />

            <Button
                Text="Create"
                BackgroundColor="#0ad8c8"
                TextColor="White"
                HorizontalOptions="End"
                VerticalOptions="Center"
                Grid.Column="2"
                Clicked="OnCreateClicked" />
        </Grid>

        <!-- Quiz List -->
        <CollectionView
            Grid.Row="1"
            x:Name="QuizzesLayout"
            ItemsSource="{Binding Quizzes}"
            SelectionMode="None"
            BackgroundColor="White">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Stroke="#cccccc"
                        StrokeThickness="1"
                        StrokeShape="Rectangle"
                        Padding="10"
                        Margin="0,5"
                        BackgroundColor="White">
                        <VerticalStackLayout>
                            <!-- Quiz Name -->
                            <Label
                                Text="{Binding Name}"
                                FontSize="16"
                                TextColor="Black" />

                            <!-- Options Button -->
                            <Button
                                Text="Options"
                                BackgroundColor="#cccccc"
                                TextColor="Black"
                                CommandParameter="{Binding .}"
                                Clicked="OnQuizOptionsClicked" />

                            <!-- Start Quiz Button -->
                            <Button
                                Text="Start Quiz"
                                BackgroundColor="#0ad8c8"
                                TextColor="White"
                                CommandParameter="{Binding .}"
                                Clicked="OnStartQuizClicked" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>