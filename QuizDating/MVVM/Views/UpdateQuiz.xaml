<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuizDating.MVVM.Views.UpdateQuiz"
             Title="Update Quiz">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="10" Spacing="20" x:Name="QuestionsLayout">
                <!-- Page Title -->
                <Label Text="Update Quiz" FontSize="24" HorizontalOptions="Center" />

                <!-- Quiz Name Entry -->
                <Entry x:Name="QuizNameEntry"
                       Placeholder="Enter quiz name here"
                       FontSize="18"
                       Margin="0,10,0,0" />

                <!-- Placeholder for Questions -->
                <!-- Questions will be dynamically added here -->

                <!-- Save Quiz Button -->
                <Button Text="Save Changes"
                        FontSize="16"
                        BackgroundColor="#0ad8c8"
                        TextColor="White"
                        Margin="0,20,0,0"
                        Clicked="OnSaveChangesClicked" />
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>